%%% Margins %%%
% LuaLaTeX 2024+ compatibility: \pdfpagewidth was removed
\providecommand{\pdfpagewidth}{\pagewidth}
\providecommand{\pdfpageheight}{\pageheight}
\usepackage{geometry}
\ifthenelse{\equal{\BookPrintOption}{false}}{%
    \geometry{
        paper=a4paper,
        top=2.54cm,
        bottom=2.54cm,
        left=3.15cm,
        right=3.15cm,
        footskip=1.2cm,
        headsep=0.75cm,
        % showframe % Uncomment to display margin frames for debugging.
    }
}{%
    \geometry{
        paper=a4paper,
        top=2.54cm,
        bottom=2.54cm,
        inner=2.54cm,
        outer=3.81cm,
        footskip=1.2cm,
        headsep=0.75cm,
        bindingoffset=0.5cm,
        % showframe % Uncomment to display margin frames for debugging.
    }
}

\addtolength{\textheight}{0pt} % (sin reducción de altura de texto)
\setlength{\headheight}{20pt} % Set header height.